{
  "expo": {
    "name": "Mawaddat",
    "slug": "MawaddatApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/app/assets/images/Mawaddatlogo.png",
    "scheme": "mawaddatapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "Mawaddat.App.Ios",
      "icon": "./src/app/assets/images/Mawaddatlogo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/app/assets/images/Mawaddatlogo.png",
        "backgroundImage": "./src/app/assets/images/Mawaddatlogo.png",
        "monochromeImage": "./src/app/assets/images/Mawaddatlogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "Mawaddat.App"
    },
    "web": {
      "output": "static",
      "favicon": "./src/app/assets/images/Mawaddatlogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./src/app/assets/images/Mawaddatlogo.png",
          "imageWidth": 76
        }
      ],
      "expo-asset",
      "expo-build-properties",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "279ba0ba-e6ae-4806-b0ac-a6de89a704dc"
      }
    },
    "owner": "itzzzamaan"
  }
}
